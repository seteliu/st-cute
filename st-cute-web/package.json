{
  "name": "st-cute-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\"",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss,json,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,scss,json,md}\" \"*.{js,ts,json,md}\""
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.6",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.1.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.7"
  }
}
